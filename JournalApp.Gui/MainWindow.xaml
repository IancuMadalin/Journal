<Window x:Class="JournalApp.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JournalApp.Gui"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowState="Maximized">
    
    <Grid Background="Blue">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height = "*"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" 
                        Margin="10"
                        Name = "ButtonStack">
                             <Button Content = "View all entries"
                                     Click="ViewAllEntries_OnClick" 
                                     Style="{StaticResource Menu}"></Button>
                             <Button Content = "Add entry"
                                     Click="AddEntryButton_OnClick"
                                     Style="{StaticResource Menu}"></Button>
                             <Button Content = "Search entry"></Button>
                             <Button Content = "Hide" Click = "Hide_OnCLick"
                                     Style="{StaticResource Menu}"></Button>
                         </StackPanel>
            <!--In acest ListBox apar titlurile Entry-urilor -->
            <!-- Heavy design changes required-->
            <ListBox Grid.Row ="1"
                Name ="EntryListBox" 
                Visibility="Hidden" 
                DisplayMemberPath="Name"
                Background="Green"
                BorderThickness="10"
                Margin="10"
                SelectionChanged="EntryListBox_OnSelectionChanged"
                MaxHeight="125"
                ItemContainerStyle="{StaticResource ScrollEntryItem}">
            </ListBox>
            <!-- In acest Grid apare continutul unui Entry -->
            <Grid Grid.Row = "2"
                  Name = "DisplayArea"
                  Background="Green"
                  Visibility="Hidden">
                <Grid.RowDefinitions>
                    <RowDefinition Height = "Auto"></RowDefinition>
                    <RowDefinition Height = "Auto"></RowDefinition>
                    <RowDefinition Height = "Auto"></RowDefinition>
                    <RowDefinition Height = "Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row = "0" Name = "Title"
                           Margin="0,0,0,10"></TextBlock>
                <TextBlock Grid.Row = "1" Name = "Date"
                           Margin="0,0,0,10"></TextBlock>
                <TextBlock Grid.Row = "2" Name = "Content"></TextBlock>
                <StackPanel Grid.Row="3"
                            Name = "EditDeleteButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="Hidden">
                    <Button Content="Edit Entry"></Button>
                    <Button Content="Delete Entry"
                            Name = "DeleteButton"
                            Click="DeleteButton_OnClick"></Button>
                </StackPanel>
            </Grid>
            </Grid>
</Window>
