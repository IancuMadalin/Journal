<Window x:Class="JournalApp.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JournalApp.Gui"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
        <Grid Background="Blue">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height = "*"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" 
                        Margin="10">
                             <Button Content = "View all entries"
                                     Click="ViewAllEntries_OnClick" 
                                     Style="{StaticResource Menu}"></Button>
                             <Button Content = "Add entry"
                                     Click="AddEntryButton_OnClick"
                                     Style="{StaticResource Menu}"></Button>
                             <Button Content = "Delete entry"></Button>
                             <Button Content = "Search entry"></Button>
                             <Button Content = "Hide" Click = "Hide_OnCLick"></Button>
                         </StackPanel>
            <!--In acest ListBox apar titlurile Entry-urilor -->
            <ListBox Grid.Row ="1"
                Name ="EntryListBox" 
                Visibility="Hidden" 
                DisplayMemberPath="Name"
                Background="Green"
                SelectionChanged="EntryListBox_OnSelectionChanged">
            </ListBox>
            <!-- In acest Grid apare continutul unui Entry -->
            <Grid Grid.Row = "2"
                  Name = "DisplayArea"
                  Background="Green"
                  Visibility="Hidden">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height = "Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row = "0" Name = "Title"
                           Margin="0,0,0,10"></TextBlock>
                <TextBlock Grid.Row = "1" Name = "Date"
                           Margin="0,0,0,10"></TextBlock>
                <TextBlock Grid.Row = "2" Name = "Content"></TextBlock> 
            </Grid>
            <!-- In acest Grid apare sectiunea de adaugarea pentru un Entry nou -->
                <Grid Grid.Row="2"
                  Name = "AddArea"
                  Background="DarkMagenta"
                  Visibility="Hidden">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Row="0"
                           Grid.Column="0">Title: </TextBlock>
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,0,0"
                         Name = "TitleInputBox"
                         TextChanged="TitleInputBox_OnTextChanged"></TextBox>
                
                <TextBlock Grid.Row="1"
                           Grid.Column="0">Content: </TextBlock>
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,0,0,0"
                         Name="ContentInputBox"></TextBox>
                    
                    <Button Grid.Row="2"
                            Grid.Column="0"
                            Name="AddNewEntryButton"
                            Content="Add new entry"
                            Visibility="Hidden"
                            Click="AddNewEntryButton_OnClick"></Button>
                    <TextBlock  Grid.Row="2"
                                Grid.Column="1"
                                Name="NewEntryResponseBlock"
                                Visibility="Hidden"></TextBlock>
                       
                </Grid>
                
            
                
            </Grid>
</Window>
